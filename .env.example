# App
APP_URL=http://localhost:3000
SESSION_SECRET=                 # 32+ random chars: openssl rand -base64 32
ENCRYPTION_KEY=                 # 32+ random chars, encrypts stored channel tokens: openssl rand -base64 32

# Database (MySQL in docker-compose; phpMyAdmin at http://localhost:8086)
DATABASE_URL=mysql://podo:podo@localhost:3307/podo_social
REDIS_URL=redis://localhost:6381

# First login, created by `pnpm db:seed` (dev only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Media uploads
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=uploads

# Podo AI: text by Claude, images (optional) by OpenAI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_DEFAULT_MONTHLY_BUDGET_USD=50
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Meta (Facebook / Instagram)
META_APP_ID=1425390532878774
META_APP_SECRET=
META_APP_TOKEN=
META_GRAPH_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=
META_BUSINESS_ID=896691718918940
META_PAGE_ID=259986377195834
META_IG_ID=17841459370728904
META_AD_ACCOUNT_ID=act_623028240126874
META_TEST_AD_ACCOUNT_IDS=act_623028240126874
# Dev only: short-lived Graph API Explorer user token for testing. Never commit a value.
META_TEST_USER_TOKEN=

# WhatsApp (system user token: whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Forward Meta WhatsApp webhooks to PodoCRM (Route B — Meta webhook stays on Social)
PODOCRM_WHATSAPP_WEBHOOK_URL=https://podocrm.podospheretechnologies.com/api/whatsapp/webhook
# Optional: set to false to disable forwarding
# PODOCRM_WHATSAPP_FORWARD=false
# PodoCRM API base for sync link / ping / echo (Integrations → Link PodoCRM)
PODOCRM_API_BASE_URL=https://podocrm.podospheretechnologies.com/api

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest (https://developers.pinterest.com/). Redirect URI:
# {APP_URL}/api/social/integrations/callback/pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Google Sheets (Plugs + Generate Post). Create OAuth client at https://console.cloud.google.com/
# Redirect URI: http://localhost:3000/api/social/google-sheets/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads connector: developer token from the MCC API Center; redirect URI to allow: {APP_URL}/api/social/ads/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v24

# Email (Resend) — monthly client report PDFs to ClientApprover addresses.
# Without RESEND_API_KEY, report generation still works; email delivery is skipped (logged).
RESEND_API_KEY=
# Optional From header. Default: Podo Social <noreply@podospheretechnologies.com>
EMAIL_FROM=

# Razorpay (optional). Without keys, billing page shows plans but checkout is disabled.
# Webhook URL: {APP_URL}/api/webhooks/razorpay
# Events: payment.captured, order.paid, subscription.activated, subscription.charged,
#         subscription.halted, subscription.cancelled
# See docs/ops-runbook.md § Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Map plan keys → Razorpay Subscription Plan IDs (dashboard → Subscriptions → Plans).
# When set, checkout creates a real subscription; when empty, one-time order is used.
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_AGENCY_STARTER=
RAZORPAY_PLAN_AGENCY_GROWTH=
RAZORPAY_PLAN_AGENCY_PRO=
# GST invoices (PDF on payment webhook; optional regenerate via API)
BILLING_SELLER_GSTIN=
# Optional 2-digit GST state code when GSTIN is unset (for CGST/SGST vs IGST)
BILLING_SELLER_STATE=
BILLING_GST_PERCENT=18

# WhatsApp broadcast cost estimate (paise per template message). Used in confirm UI.
WHATSAPP_BROADCAST_RATE_PAISE=80

# WhatsApp Embedded Signup (client FB.login). Optional until onboarding is enabled.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

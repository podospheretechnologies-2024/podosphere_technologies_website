# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (local build cache — the packaged server lives in deploy/standalone)
/.next/
/out/

# production
/build
# Prebuilt Next standalone server (committed so prod can skip `pnpm build`)
!/deploy/standalone/
!/deploy/standalone/**

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local media uploads
/uploads

# local MySQL dumps (pnpm db:backup)
/backups

!.env.example

# Meta MCP export (client ad account data, not for git)
/data/mcp-export/

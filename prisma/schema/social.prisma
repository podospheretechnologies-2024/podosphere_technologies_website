model SocialSyncState {
  id             String    @id @default(uuid())
  organizationId String
  integrationId  String?
  adAccountId    String?
  kind           String
  cursor         String?   @db.Text
  lastRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastError      String?   @db.Text
  failures       Int       @default(0)

// Social media module: channels, posts, media library and automation.

enum SocialPostState {
  DRAFT
  QUEUE
  PUBLISHED
  ERROR
}

// Multi-step approval for client-scoped drafts (PODO_SOCIAL_CLIENT_PLAN.md P1).
// null = not in an approval workflow. Posts stay DRAFT until APPROVED → QUEUE.
enum SocialApprovalStep {
  INTERNAL
  CLIENT
  APPROVED
  REJECTED
}

enum SocialCreationMethod {
  WEB
  API
  AI
  AUTOPOST
  UNKNOWN
}

// How often a repeating post group is cloned after a successful publish (F9).
enum SocialRecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
}

enum SocialMediaType {
  IMAGE
  VIDEO
}

enum SocialMediaStatus {
  PROCESSING
  READY
  FAILED
}

// Where the file is meant to be published, e.g. an Instagram feed post, reel or story.
enum SocialMediaFormat {
  POST
  REEL
  STORY
}

// A connected social account (a "channel").
model SocialIntegration {
  id                    String    @id @default(cuid())
  organizationId        String
  customerId            String?
  providerIdentifier    String
  internalId            String
  rootInternalId        String?
  name                  String
  username              String?
  picture               String?   @db.VarChar(2048)
  accessToken           String    @db.Text
  refreshToken          String?   @db.Text
  tokenExpiration       DateTime?
  disabled              Boolean   @default(false)
  // Waiting for a second connect step (e.g. choosing a page after OAuth).
  inBetweenSteps        Boolean   @default(false)
  // Token could not be refreshed; the user must reconnect the channel.
  refreshNeeded         Boolean   @default(false)
  // Preferred posting times, in minutes after midnight (UTC).
  postingTimes          Json      @default("[{\"time\":120},{\"time\":400},{\"time\":700}]")
  additionalSettings    Json      @default("[]")
  customInstanceDetails String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  organization Organization               @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?            @relation(fields: [customerId], references: [id])
  posts        SocialPost[]
  webhooks     SocialWebhookIntegration[]

  @@unique([organizationId, providerIdentifier, internalId])
  @@index([organizationId])
  @@index([providerIdentifier])
  @@index([customerId])
  @@index([deletedAt])
  @@map("social_integrations")
}

// Groups channels that belong to the same client.
model SocialCustomer {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  // Onboarding wizard: created → connect_link → channels → brand_kit → done
  onboardingStep String    @default("created") @db.VarChar(32)
  // Copied from SocialClientTemplate on apply: postingScheduleHints + sourceChannels.
  templateBootstrap Json?
  // Optional soft AI spend cap for this client (USD / calendar month). Null = no per-client cap.
  aiMonthlyBudgetUsd Decimal? @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization          Organization               @relation(fields: [organizationId], references: [id])
  integrations          SocialIntegration[]
  members               SocialClientMember[]
  approvers             ClientApprover[]
  adAccounts            AdAccount[]
  googleAdsAccounts     SocialGoogleAdsAccount[]
  posts                 SocialPost[]
  media                 SocialMedia[]
  brandKits             SocialBrandKit[]
  inboxThreads          SocialInboxThread[]
  leads                 SocialLead[]
  reports               SocialClientReport[]
  tags                  SocialTag[]
  signatures            SocialSignature[]
  savedReplies          SocialSavedReply[]
  sets                  SocialSet[]
  autoPosts             SocialAutoPost[]
  whatsappConversations WhatsAppConversation[]
  whatsappBroadcasts    WhatsAppBroadcast[]
  whatsappConnections   SocialWhatsAppConnection[]
  whatsappAutoReplies   SocialWhatsAppAutoReply[]
  apiClients            SocialApiClient[]
  aiUsages              SocialAiUsage[]
  aiThreads             SocialAiThread[]
  aiActions             SocialAiAction[]
  shortLinks            SocialShortLink[]

  @@index([organizationId])
  @@map("social_customers")
}

// Agency-reusable snapshot of a client's setup (brand kit, tags, signatures, sets, schedule hints).
model SocialClientTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("social_client_templates")
}

// One row per channel. Posts created together share the same `group`;
// thread replies point to their parent through `parentPostId`.
model SocialPost {
  id             String               @id @default(cuid())
  organizationId String
  customerId     String?
  integrationId  String
  group          String
  parentPostId   String?
  state          SocialPostState      @default(QUEUE)
  // null when not in review; INTERNAL / CLIENT while waiting; APPROVED / REJECTED terminal.
  approvalStep   SocialApprovalStep?
  publishDate    DateTime
  content        String               @db.Text
  // Optional first comment under the published post (e.g. IG hashtags).
  firstComment   String?              @map("first_comment") @db.Text
  // Minutes to wait after the previous item of a thread.
  delay          Int                  @default(0)
  settings       Json                 @default("{}")
  media          Json                 @default("[]")
  title          String?              @db.Text
  description    String?              @db.Text
  releaseId      String?
  releaseUrl     String?              @db.VarChar(2048)
  error          String?              @db.Text
  intervalInDays Int?
  creationMethod SocialCreationMethod @default(WEB)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?     @relation(fields: [customerId], references: [id])
  integration  SocialIntegration   @relation(fields: [integrationId], references: [id])
  parentPost   SocialPost?         @relation("SocialPostThread", fields: [parentPostId], references: [id])
  children     SocialPost[]        @relation("SocialPostThread")
  tags         SocialTagsOnPosts[]
  errors       SocialPostError[]

  @@index([organizationId])
  @@index([integrationId])
  @@index([group])
  @@index([parentPostId])
  @@index([state])
  @@index([publishDate])
  @@index([deletedAt])
  @@index([organizationId, customerId])
  @@index([organizationId, customerId, approvalStep])
  @@map("social_posts")
}

// Repeat schedule for a post group. After a successful publish the worker clones
// the group for the next run and moves `group` to the clone.
model SocialRecurrence {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  /// Current post group this recurrence is attached to (updated on each clone).
  group          String               @unique
  rule           SocialRecurrenceRule
  until          DateTime?
  maxRuns        Int?                 @map("max_runs")
  runCount       Int                  @default(0) @map("run_count")
  /// When true, the next clone prefers an empty calendar slot (light evergreen).
  evergreen      Boolean              @default(false)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, active])
  @@map("social_recurrences")
}

model SocialMedia {
  id                 String            @id @default(uuid())
  organizationId     String
  customerId         String?
  name               String
  originalName       String?           @db.VarChar(512)
  path               String            @db.VarChar(1024)
  type               SocialMediaType   @default(IMAGE)
  format             SocialMediaFormat @default(POST)
  mimeType           String?
  fileSize           Int               @default(0)
  width              Int?
  height             Int?
  thumbnail          String?           @db.VarChar(1024)
  thumbnailTimestamp Int?
  alt                String?           @db.Text
  /// AI caption suggestions from vision on upload (string[]). Soft-fail if vision is off/unavailable.
  captionIdeas       Json?             @map("caption_ideas")
  /// One stored platform crop (helper can produce others on demand).
  variantPath        String?           @map("variant_path") @db.VarChar(1024)
  variantKey         String?           @map("variant_key") @db.VarChar(32)
  status             SocialMediaStatus @default(READY)
  processingError    String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([format])
  @@index([deletedAt])
  @@index([organizationId, customerId])
  @@map("social_media")
}

model SocialTag {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String?
  name           String
  color          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?     @relation(fields: [customerId], references: [id])
  posts        SocialTagsOnPosts[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("social_tags")
}

model SocialTagsOnPosts {
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  SocialTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("social_tags_on_posts")
}

// Text automatically (or manually) appended to posts.
model SocialSignature {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String?
  content        String    @db.Text
  autoAdd        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("social_signatures")
}

// Tracked short links with UTM params; public redirect at /l/[code].
model SocialShortLink {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String?
  code           String    @unique @db.VarChar(32)
  targetUrl      String    @db.VarChar(2048)
  utmSource      String?   @db.VarChar(120)
  utmMedium      String?   @db.VarChar(120)
  utmCampaign    String?   @db.VarChar(120)
  utmTerm        String?   @db.VarChar(120)
  utmContent     String?   @db.VarChar(120)
  clicks         Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("social_short_links")
}

// Canned inbox replies (agency-wide when customerId is null, or per client).
model SocialSavedReply {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String?
  title          String    @db.VarChar(120)
  body           String    @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("social_saved_replies")
}

// Reusable post templates (selected channels + content + settings).
model SocialSet {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  name           String
  content        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("social_sets")
}

// RSS feed that is turned into posts automatically.
model SocialAutoPost {
  id              String    @id @default(uuid())
  organizationId  String
  customerId      String?
  title           String
  url             String    @db.VarChar(2048)
  lastUrl         String?   @db.VarChar(2048)
  content         String?   @db.Text
  integrationIds  Json // string[] (MySQL has no list columns)
  onSlot          Boolean   @default(true)
  syncLast        Boolean   @default(false)
  addPicture      Boolean   @default(false)
  generateContent Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("social_auto_posts")
}

// Called after a post from one of the linked channels is published.
model SocialWebhook {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  url            String    @db.VarChar(2048)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization               @relation(fields: [organizationId], references: [id])
  integrations SocialWebhookIntegration[]

  @@index([organizationId])
  @@map("social_webhooks")
}

model SocialWebhookIntegration {
  webhookId     String
  integrationId String

  webhook     SocialWebhook     @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  integration SocialIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([webhookId, integrationId])
  @@map("social_webhook_integrations")
}

/// In-app + optional email alerts for agencies (F12 / B2).
/// `type` values: approval_needed | post_failed | token_expired | sla_breached | budget_80 | new_lead | alert
model SocialNotification {
  id             String    @id @default(uuid())
  organizationId String
  type           String    @default("alert") @db.VarChar(40)
  content        String    @db.Text
  link           String?   @db.VarChar(2048)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, readAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@map("social_notifications")
}

// Raw provider error captured when publishing fails.
model SocialPostError {
  id             String   @id @default(uuid())
  organizationId String
  postId         String
  platform       String
  message        String   @db.Text
  body           Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  post         SocialPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([postId])
  @@map("social_post_errors")
}

// Podo AI brand kit: voice, audience, words to use/avoid, FAQs. Read into every AI prompt.
// One kit per (organization, client). MySQL allows multiple NULLs in a unique index, so
// agency kits (customerId = null) are de-duped in app code (findFirst + update/create).
model SocialBrandKit {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@unique([organizationId, customerId])
  @@map("social_brand_kits")
}

// Tokens used per Claude call; drives the monthly AI budget.
model SocialAiUsage {
  id               String   @id @default(uuid())
  organizationId   String
  // Client that triggered the call when scope is a single customer; null = agency / all-clients.
  customerId       String?
  feature          String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@map("social_ai_usages")
}

// Copilot agent conversation (F7). Scope is fixed at create from session ClientScope.
model SocialAiThread {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  userId         String?
  title          String?  @db.VarChar(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?  @relation(fields: [customerId], references: [id])
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages     SocialAiMessage[]
  actions      SocialAiAction[]

  @@index([organizationId, customerId, updatedAt])
  @@index([organizationId, updatedAt])
  @@map("social_ai_threads")
}

// Append-only turns. `content` is Anthropic message content JSON (text / tool_use / tool_result).
model SocialAiMessage {
  id        String   @id @default(uuid())
  threadId  String
  role      String   @db.VarChar(16) // user | assistant
  content   Json
  createdAt DateTime @default(now())

  thread SocialAiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("social_ai_messages")
}

// Write-tool proposals. Status: pending | approved | rejected. Never auto-executes.
model SocialAiAction {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String?
  threadId       String
  toolName       String    @db.VarChar(64)
  payload        Json
  status         String    @db.VarChar(16) @default("pending")
  result         Json?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])
  thread       SocialAiThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([threadId, status])
  @@map("social_ai_actions")
}

// WhatsApp Cloud API conversation (one contact chatting with the business number).
model WhatsAppConversation {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  /// WhatsApp id of the contact (usually E.164 without +).
  waId           String
  contactName    String?
  lastMessageAt  DateTime
  lastInboundAt  DateTime?
  lastPreview    String?   @db.VarChar(500)
  unreadCount    Int       @default(0)
  /// Set when the contact texts STOP / UNSUBSCRIBE (broadcast opt-out).
  optedOutAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?   @relation(fields: [customerId], references: [id])
  messages     WhatsAppMessage[]

  @@unique([organizationId, waId])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, customerId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  /// Meta Cloud API message id (wamid.…); unique when present.
  wamid          String?  @unique
  direction      String // inbound | outbound
  type           String   @default("text")
  body           String   @db.Text
  status         String? // sent | delivered | read | failed
  /// Where the message originated: customer | podosocial | podocrm | unknown
  source         String?
  /// Display name for outbound (e.g. "Sushant (PodoCRM)")
  senderLabel    String?  @db.VarChar(191)
  timestamp      DateTime
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id])
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@index([organizationId, timestamp])
  @@map("whatsapp_messages")
}

// Google Sheets plug: one OAuth connection per organization.
model SocialGoogleSheetsConnection {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  email           String
  name            String?
  picture         String?   @db.VarChar(2048)
  accessToken     String    @db.Text
  refreshToken    String?   @db.Text
  tokenExpiration DateTime?
  scopes          String    @db.Text
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id])
  spreadsheets SocialGoogleSpreadsheet[]

  @@map("social_google_sheets_connections")
}

// Cached spreadsheet + row data for the connected Google account.
model SocialGoogleSpreadsheet {
  id            String    @id @default(uuid())
  connectionId  String
  spreadsheetId String
  name          String
  url           String    @db.VarChar(2048)
  modifiedTime  DateTime?
  sheetNames    Json
  headers       Json
  rows          Json
  rowCount      Int       @default(0)
  syncedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connection SocialGoogleSheetsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, spreadsheetId])
  @@index([connectionId])
  @@map("social_google_spreadsheets")
}

// PodoCRM WhatsApp sync link (redeem PSL-… code from CRM Connectors).
model SocialPodoCrmWhatsAppSync {
  id               String    @id @default(uuid())
  organizationId   String    @unique
  /// Encrypted HMAC secret from CRM link response — never return plaintext to the UI.
  syncSecret       String    @db.Text
  phoneNumberId    String
  podocrmCompanyId String
  podocrmBaseUrl   String    @db.VarChar(512)
  linkedAt         DateTime  @default(now())
  lastPingAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([phoneNumberId])
  @@map("social_podocrm_whatsapp_sync")
}

model AdAccount {
  id                    String   @id @default(uuid())
  organizationId        String
  customerId            String?
  externalId            String // "act_123…"
  name                  String
  currency              String   @db.VarChar(3)
  /// IANA timezone from Meta `timezone_name` (e.g. "Asia/Kolkata"). Used for insight date buckets.
  timezoneName          String   @map("timezone_name")
  status                Int
  tokenSource           String   @default("system_user")
  /// AES-GCM encrypted Meta system-user / business token for this ad account (see `@/shared/lib/crypto`).
  accessTokenEncrypted  String?  @db.Text
  /// True when Graph returned an auth error (code 190); agency must set a fresh token.
  refreshNeeded         Boolean  @default(false)
  createdAt             DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@unique([externalId])
  @@index([organizationId, customerId])
  @@map("ad_accounts")
}

// Google Ads connector: one OAuth connection per organization (read-only reporting).
model SocialGoogleAdsConnection {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  email           String
  name            String?
  picture         String?   @db.VarChar(2048)
  accessToken     String    @db.Text
  refreshToken    String?   @db.Text
  tokenExpiration DateTime?
  scopes          String    @db.Text
  /// Manager (MCC) customer id sent as login-customer-id; null = use GOOGLE_ADS_LOGIN_CUSTOMER_ID / direct access.
  loginCustomerId String?
  lastSyncedAt    DateTime?
  /// Last account-discovery error (e.g. developer token not approved); shown in the UI.
  lastError       String?   @db.VarChar(512)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  accounts     SocialGoogleAdsAccount[]

  @@map("social_google_ads_connections")
}

// Leaf Google Ads customer accounts reachable from the connection; optionally assigned to a client.
model SocialGoogleAdsAccount {
  id               String   @id @default(uuid())
  organizationId   String
  connectionId     String
  customerId       String?
  /// Digits only, e.g. "1234567890".
  googleCustomerId String
  /// Manager account used to reach this customer (login-customer-id header); null when accessed directly.
  loginCustomerId  String?
  name             String
  currency         String   @db.VarChar(3)
  timeZone         String
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connection SocialGoogleAdsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  customer   SocialCustomer?           @relation(fields: [customerId], references: [id])

  @@unique([connectionId, googleCustomerId])
  @@index([organizationId, customerId])
  @@map("social_google_ads_accounts")
}

model SocialClientMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  customerId     String
  permissions    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  customer     SocialCustomer @relation(fields: [customerId], references: [id])

  @@unique([userId, customerId])
  @@index([organizationId])
  @@map("social_client_members")
}

model ClientApprover {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String
  email          String
  name           String?
  lastSeenAt     DateTime?
  // Bumped every time a one-time magic link is consumed, and can be bumped manually to revoke
  // every outstanding link/session for this approver. Embedded in magic-link JWTs as `ver`.
  tokenVersion   Int       @default(0)
  createdAt      DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer @relation(fields: [customerId], references: [id])

  @@unique([customerId, email])
  @@map("client_approvers")
}

model SocialInsightDaily {
  id            String   @id @default(uuid())
  integrationId String
  date          DateTime @db.Date
  /// Canonical keys: followers | reach | impressions | profile_views | website_clicks
  metric        String   @db.VarChar(40)
  value         Decimal  @db.Decimal(20, 4)
  fetchedAt     DateTime @updatedAt

  @@unique([integrationId, date, metric])
  @@index([metric])
  @@map("social_insights_daily")
}

model SocialExternalPost {
  id             String    @id @default(uuid())
  integrationId  String
  externalId     String
  socialPostId   String?
  type           String
  caption        String?   @db.Text
  permalink      String?   @db.VarChar(2048)

model SocialCompetitor {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?  @map("customer_id")
  name           String
  platform       String // "instagram" or "facebook"
  externalId     String // The public ID or Username of the competitor
  createdAt      DateTime @default(now())

  snapshots CompetitorSnapshot[]

  @@index([organizationId])
  @@index([customerId])
  @@map("social_competitors")
}

model CompetitorSnapshot {
  id             String   @id @default(uuid())
  competitorId   String
  date           DateTime @default(now())
  followers      Int
  postsCount     Int?
  engagementRate Float?
  /** Recent public media from business_discovery: CompetitorMediaItem[] */
  recentMedia    Json?    @map("recent_media")

  competitor SocialCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@map("competitor_snapshots")
}

// Public API keys (section 9). Only the hash is stored.
model SocialApiClient {
  id             String    @id @default(uuid())
  organizationId String
  /** When set, `/api/v1/*` is limited to this client; null = whole organization. */
  customerId     String?
  name           String
  tokenHash      String    @unique
  tokenPrefix    String    @db.VarChar(16)
  permissions    Json
  dailyLimit     Int       @default(1000)
  ipAllowlist    String?   @db.Text
  status         String    @default("active")
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  usages       SocialApiUsageLog[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("social_api_clients")
}

model SocialApiUsageLog {
  id          String   @id @default(uuid())
  apiClientId String
  path        String   @db.VarChar(191)
  statusCode  Int
  createdAt   DateTime @default(now())

  apiClient SocialApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@index([apiClientId, createdAt])
  @@map("social_api_usage_logs")
}

model SocialInboxThread {
  id              String    @id @default(uuid())
  organizationId  String
  customerId      String?
  platform        String
  // 'comment' | 'dm' — set on webhook ingest for reply/hide dispatch.
  kind            String?
  // Page id (facebook) or IG business account id from the webhook entry.
  channelInternalId String?
  externalId      String
  contactName     String?
  lastPreview     String?   @db.VarChar(500)
  lastMessageAt   DateTime
  assigneeId      String?
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  // Set by alerts.slaSweep when slaDueAt passed with no first response.
  slaBreachedAt   DateTime?
  // Set when a FB/IG comment on this thread is hidden via Graph is_hidden.
  hiddenAt        DateTime?
  // AI triage (on-demand POST …/triage). Labels: question|complaint|lead|spam|praise|other.
  aiLabel         String?   @map("ai_label") @db.VarChar(32)
  // low|normal|high|urgent
  aiPriority      String?   @map("ai_priority") @db.VarChar(16)
  // positive|neutral|negative
  aiSentiment     String?   @map("ai_sentiment") @db.VarChar(16)
  aiDraft         String?   @map("ai_draft") @db.Text
  aiTriagedAt     DateTime? @map("ai_triaged_at")
  createdAt       DateTime  @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?      @relation(fields: [customerId], references: [id])
  assignee     User?                @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     SocialInboxMessage[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, customerId])
  @@index([organizationId, assigneeId])
  @@index([organizationId, slaDueAt])
  @@index([slaDueAt, firstResponseAt, slaBreachedAt])
  @@index([organizationId, aiLabel])
  @@index([organizationId, aiPriority])
  @@map("social_inbox_threads")
}

model SocialInboxMessage {
  id         String    @id @default(uuid())
  threadId   String
  direction  String
  body       String    @db.Text
  externalId String?
  // Set when this inbound comment is hidden on Meta (is_hidden=true).
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())

  thread SocialInboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("social_inbox_messages")
}

model SocialLead {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String?
  source         String
  externalId     String
  name           String?
  email          String?
  phone          String?
  stage          String    @default("new")
  // Rule-based 0–100 score (stage + contact completeness).
  score          Int?
  // string[] reasons, e.g. ["Stage: qualified (+75)", "Has phone (+15)"].
  scoreReasons   Json?     @map("score_reasons")
  scoredAt       DateTime? @map("scored_at")
  // Set when successfully pushed to PodoCRM via /sync/leads.
  crmSyncedAt    DateTime? @map("crm_synced_at")
  crmExternalId  String?   @map("crm_external_id") @db.VarChar(128)
  payload        Json
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@unique([organizationId, source, externalId])
  @@index([organizationId, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, stage])
  @@index([organizationId, score])
  @@index([organizationId, crmSyncedAt])
  @@map("social_leads")
}

model SocialClientReport {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  body           String   @db.Text
  // AI wins / losses / next steps; null when Claude is off or generation soft-failed.
  narrative      String?  @db.Text
  // Served via local storage route (/api/social/media/files/…) or cloud URL.
  pdfUrl         String?  @db.VarChar(2048)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, customerId])
  @@map("social_client_reports")
}

model SocialSubscription {
  id                     String    @id @default(uuid())
  organizationId         String    @unique
  plan                   String
  razorpaySubscriptionId String?
  razorpayOrderId        String?
  status                 String    @default("created")
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("social_subscriptions")
}

/// GST tax invoice metadata for Razorpay payments (PDF via invoice-pdf + uploads storage).
model BillingInvoice {
  id                 String   @id @default(uuid())
  organizationId     String
  number             String
  /// Seller GSTIN (from BILLING_SELLER_GSTIN at issue time).
  gstin              String?
  /// Buyer GSTIN snapshot from organization / checkout.
  buyerGstin         String?  @db.VarChar(20)
  /// Place of supply snapshot (state name or GST state code).
  placeOfSupply      String?  @db.VarChar(120)
  plan               String?
  taxableAmountPaise Int      @default(0)
  cgstPaise          Int      @default(0)
  sgstPaise          Int      @default(0)
  igstPaise          Int      @default(0)
  totalPaise         Int      @default(0)
  currency           String   @default("INR")
  pdfUrl             String?  @db.VarChar(2048)
  razorpayPaymentId  String?
  razorpayOrderId    String?
  /// Extra line items / notes.
  metadata           Json?
  status             String   @default("issued")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, createdAt])
  @@map("billing_invoices")
}

model WhatsAppBroadcast {
  id                  String    @id @default(uuid())
  organizationId      String
  customerId          String?
  name                String
  templateName        String
  language            String
  status              String    @default("draft")
  recipientCount      Int       @default(0)
  sentCount           Int       @default(0)
  /// Operator acknowledged recipient consent before send.
  consentAcknowledged Boolean   @default(false)
  consentAt           DateTime?
  estimatedCostPaise  Int?
  createdAt           DateTime  @default(now())

  organization Organization                 @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?              @relation(fields: [customerId], references: [id])
  recipients   WhatsAppBroadcastRecipient[]

  @@index([organizationId, createdAt])
  @@index([organizationId, customerId])
  @@map("whatsapp_broadcasts")
}

model WhatsAppBroadcastRecipient {
  id          String  @id @default(uuid())
  broadcastId String
  phone       String
  status      String  @default("pending")
  wamid       String?
  error       String? @db.Text

  broadcast WhatsAppBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@map("whatsapp_broadcast_recipients")
}

// Client WABA connected through WhatsApp Embedded Signup.
// phoneNumberId is globally unique so webhooks can resolve the connection.
model SocialWhatsAppConnection {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  wabaId         String
  phoneNumberId  String   @unique
  displayPhone   String?
  businessName   String?
  accessToken    String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer? @relation(fields: [customerId], references: [id])

  @@index([organizationId, customerId])
  @@map("social_whatsapp_connections")
}

// Keyword / regex auto-replies for inbound WhatsApp (F15).
// matchType keyword = case-insensitive substring; regex = JS RegExp on the body.
// replyType text | template. Optional business-hours window (timezone + days + HH:mm).
model SocialWhatsAppAutoReply {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String?
  name           String    @db.VarChar(120)
  matchType      String    @db.VarChar(16) // 'keyword' | 'regex'
  pattern        String    @db.VarChar(500)
  caseSensitive  Boolean   @default(false)
  replyType      String    @db.VarChar(16) // 'text' | 'template'
  replyText      String?   @db.Text
  templateName   String?   @db.VarChar(120)
  templateLanguage String? @db.VarChar(16)
  templateVariables Json? // string[]
  businessHoursEnabled Boolean @default(false)
  businessHoursStart   String? @db.VarChar(5) // HH:mm
  businessHoursEnd     String? @db.VarChar(5)
  businessHoursTimezone String? @db.VarChar(64) // IANA, default Asia/Kolkata at runtime
  businessHoursDays    Json? // number[] 0=Sun … 6=Sat
  priority       Int       @default(100) // lower runs first
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], map: "swa_auto_replies_organizationId_fkey")
  customer     SocialCustomer? @relation(fields: [customerId], references: [id], map: "swa_auto_replies_customerId_fkey")

  @@index([organizationId, customerId, active], map: "swa_auto_replies_org_cust_active_idx")
  @@index([organizationId, priority], map: "swa_auto_replies_org_priority_idx")
  @@map("social_whatsapp_auto_replies")
}

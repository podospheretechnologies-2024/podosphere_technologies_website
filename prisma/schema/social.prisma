// Social media module: channels, posts, media library and automation.

enum SocialPostState {
  DRAFT
  QUEUE
  PUBLISHED
  ERROR
}

enum SocialCreationMethod {
  WEB
  API
  AI
  AUTOPOST
  UNKNOWN
}

enum SocialMediaType {
  IMAGE
  VIDEO
}

enum SocialMediaStatus {
  PROCESSING
  READY
  FAILED
}

// Where the file is meant to be published, e.g. an Instagram feed post, reel or story.
enum SocialMediaFormat {
  POST
  REEL
  STORY
}

// A connected social account (a "channel").
model SocialIntegration {
  id                    String    @id @default(cuid())
  organizationId        String
  customerId            String?
  providerIdentifier    String
  internalId            String
  rootInternalId        String?
  name                  String
  username              String?
  picture               String?   @db.VarChar(2048)
  accessToken           String    @db.Text
  refreshToken          String?   @db.Text
  tokenExpiration       DateTime?
  disabled              Boolean   @default(false)
  // Waiting for a second connect step (e.g. choosing a page after OAuth).
  inBetweenSteps        Boolean   @default(false)
  // Token could not be refreshed; the user must reconnect the channel.
  refreshNeeded         Boolean   @default(false)
  // Preferred posting times, in minutes after midnight (UTC).
  postingTimes          Json      @default("[{\"time\":120},{\"time\":400},{\"time\":700}]")
  additionalSettings    Json      @default("[]")
  customInstanceDetails String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  organization Organization               @relation(fields: [organizationId], references: [id])
  customer     SocialCustomer?            @relation(fields: [customerId], references: [id])
  posts        SocialPost[]
  webhooks     SocialWebhookIntegration[]

  @@unique([organizationId, providerIdentifier, internalId])
  @@index([organizationId])
  @@index([providerIdentifier])
  @@index([customerId])
  @@index([deletedAt])
  @@map("social_integrations")
}

// Groups channels that belong to the same client.
model SocialCustomer {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  integrations SocialIntegration[]

  @@index([organizationId])
  @@map("social_customers")
}

// One row per channel. Posts created together share the same `group`;
// thread replies point to their parent through `parentPostId`.
model SocialPost {
  id             String               @id @default(cuid())
  organizationId String
  integrationId  String
  group          String
  parentPostId   String?
  state          SocialPostState      @default(QUEUE)
  publishDate    DateTime
  content        String               @db.Text
  // Minutes to wait after the previous item of a thread.
  delay          Int                  @default(0)
  settings       Json                 @default("{}")
  media          Json                 @default("[]")
  title          String?              @db.Text
  description    String?              @db.Text
  releaseId      String?
  releaseUrl     String?              @db.VarChar(2048)
  error          String?              @db.Text
  intervalInDays Int?
  creationMethod SocialCreationMethod @default(WEB)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  integration  SocialIntegration   @relation(fields: [integrationId], references: [id])
  parentPost   SocialPost?         @relation("SocialPostThread", fields: [parentPostId], references: [id])
  children     SocialPost[]        @relation("SocialPostThread")
  tags         SocialTagsOnPosts[]
  errors       SocialPostError[]

  @@index([organizationId])
  @@index([integrationId])
  @@index([group])
  @@index([parentPostId])
  @@index([state])
  @@index([publishDate])
  @@index([deletedAt])
  @@map("social_posts")
}

model SocialMedia {
  id                 String            @id @default(uuid())
  organizationId     String
  name               String
  originalName       String?           @db.VarChar(512)
  path               String            @db.VarChar(1024)
  type               SocialMediaType   @default(IMAGE)
  format             SocialMediaFormat @default(POST)
  mimeType           String?
  fileSize           Int               @default(0)
  thumbnail          String?           @db.VarChar(1024)
  thumbnailTimestamp Int?
  alt                String?           @db.Text
  status             SocialMediaStatus @default(READY)
  processingError    String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([format])
  @@index([deletedAt])
  @@map("social_media")
}

model SocialTag {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  color          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  posts        SocialTagsOnPosts[]

  @@index([organizationId])
  @@map("social_tags")
}

model SocialTagsOnPosts {
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  SocialTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("social_tags_on_posts")
}

// Text automatically (or manually) appended to posts.
model SocialSignature {
  id             String    @id @default(uuid())
  organizationId String
  content        String    @db.Text
  autoAdd        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("social_signatures")
}

// Reusable post templates (selected channels + content + settings).
model SocialSet {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  content        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("social_sets")
}

// RSS feed that is turned into posts automatically.
model SocialAutoPost {
  id              String    @id @default(uuid())
  organizationId  String
  title           String
  url             String    @db.VarChar(2048)
  lastUrl         String?   @db.VarChar(2048)
  content         String?   @db.Text
  integrationIds  Json // string[] (MySQL has no list columns)
  onSlot          Boolean   @default(true)
  syncLast        Boolean   @default(false)
  addPicture      Boolean   @default(false)
  generateContent Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("social_auto_posts")
}

// Called after a post from one of the linked channels is published.
model SocialWebhook {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  url            String    @db.VarChar(2048)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization               @relation(fields: [organizationId], references: [id])
  integrations SocialWebhookIntegration[]

  @@index([organizationId])
  @@map("social_webhooks")
}

model SocialWebhookIntegration {
  webhookId     String
  integrationId String

  webhook     SocialWebhook     @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  integration SocialIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([webhookId, integrationId])
  @@map("social_webhook_integrations")
}

model SocialNotification {
  id             String    @id @default(uuid())
  organizationId String
  content        String    @db.Text
  link           String?   @db.VarChar(2048)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@map("social_notifications")
}

// Raw provider error captured when publishing fails.
model SocialPostError {
  id             String   @id @default(uuid())
  organizationId String
  postId         String
  platform       String
  message        String   @db.Text
  body           Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  post         SocialPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([postId])
  @@map("social_post_errors")
}

// Podo AI brand kit: voice, audience, words to use/avoid, FAQs. Read into every AI prompt.
model SocialBrandKit {
  id             String   @id @default(uuid())
  organizationId String   @unique
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("social_brand_kits")
}

// Tokens used per Claude call; drives the monthly AI budget.
model SocialAiUsage {
  id               String   @id @default(uuid())
  organizationId   String
  feature          String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("social_ai_usages")
}

// WhatsApp Cloud API conversation (one contact chatting with the business number).
model WhatsAppConversation {
  id             String   @id @default(cuid())
  organizationId String
  /// WhatsApp id of the contact (usually E.164 without +).
  waId           String
  contactName    String?
  lastMessageAt  DateTime
  lastInboundAt  DateTime?
  lastPreview    String?  @db.VarChar(500)
  unreadCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  messages     WhatsAppMessage[]

  @@unique([organizationId, waId])
  @@index([organizationId, lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  /// Meta Cloud API message id (wamid.…); unique when present.
  wamid          String?  @unique
  direction      String // inbound | outbound
  type           String   @default("text")
  body           String   @db.Text
  status         String? // sent | delivered | read | failed
  timestamp      DateTime
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id])
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@index([organizationId, timestamp])
  @@map("whatsapp_messages")
}

// Google Sheets plug: one OAuth connection per organization.
model SocialGoogleSheetsConnection {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  email           String
  name            String?
  picture         String?   @db.VarChar(2048)
  accessToken     String    @db.Text
  refreshToken    String?   @db.Text
  tokenExpiration DateTime?
  scopes          String    @db.Text
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id])
  spreadsheets SocialGoogleSpreadsheet[]

  @@map("social_google_sheets_connections")
}

// Cached spreadsheet + row data for the connected Google account.
model SocialGoogleSpreadsheet {
  id             String    @id @default(uuid())
  connectionId   String
  spreadsheetId  String
  name           String
  url            String    @db.VarChar(2048)
  modifiedTime   DateTime?
  sheetNames     Json
  headers        Json
  rows           Json
  rowCount       Int       @default(0)
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection SocialGoogleSheetsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, spreadsheetId])
  @@index([connectionId])
  @@map("social_google_spreadsheets")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  // Podo AI spend cap per calendar month; null = AI_DEFAULT_MONTHLY_BUDGET_USD.
  aiMonthlyBudgetUsd Decimal?  @db.Decimal(10, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  status             OrganizationStatus @default(ACTIVE)
  plan               String             @default("agency_starter")
  maxClients         Int                @default(10)
  maxUsers           Int                @default(5)
  maxChannels        Int                @default(20)
  logoUrl            String?            @db.VarChar(2048)
  themeColor         String?            @db.VarChar(7)

  users               User[]
  socialIntegrations  SocialIntegration[]
  socialCustomers     SocialCustomer[]
  socialPosts         SocialPost[]
  socialMedia         SocialMedia[]
  socialTags          SocialTag[]
  socialSignatures    SocialSignature[]
  socialSets          SocialSet[]
  socialAutoPosts     SocialAutoPost[]
  socialWebhooks      SocialWebhook[]
  socialNotifications SocialNotification[]
  socialPostErrors    SocialPostError[]
  socialBrandKit      SocialBrandKit?
  socialAiUsages      SocialAiUsage[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  googleSheetsConnection SocialGoogleSheetsConnection?
  podoCrmWhatsAppSync   SocialPodoCrmWhatsAppSync?
  adAccounts            AdAccount[]
  invitations           Invitation[]
  clientMembers         SocialClientMember[]
  clientApprovers       ClientApprover[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

// People who can log in. Every user belongs to one organization.
model User {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  email          String    @unique
  passwordHash   String
  role           UserRole  @default(MEMBER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isPlatformAdmin Boolean  @default(false)
  lastLoginAt     DateTime?

  clientMemberships SocialClientMember[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("users")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           UserRole
  clientAccess   Json
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

model AuditLog {
  id              String   @id @default(uuid())
  organizationId  String?  
  actorUserId     String?
  impersonatorId  String?
  action          String   
  targetType      String?
  targetId        String?
  metadata        Json?
  ip              String?  @db.VarChar(64)
  createdAt       DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

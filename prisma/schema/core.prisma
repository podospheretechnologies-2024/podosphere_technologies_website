enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  // Podo AI spend cap per calendar month; null = AI_DEFAULT_MONTHLY_BUDGET_USD.
  aiMonthlyBudgetUsd Decimal?  @db.Decimal(10, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  status             OrganizationStatus @default(ACTIVE)
  plan               String             @default("agency_starter")
  maxClients         Int                @default(10)
  maxUsers           Int                @default(5)
  maxChannels        Int                @default(20)
  logoUrl            String?            @db.VarChar(2048)
  /** Agency brand colour for white-label portal (DB column `themeColor`). */
  primaryColor       String?            @map("themeColor") @db.VarChar(7)
  /** Optional portal heading; falls back to organization name. */
  portalTitle        String?            @db.VarChar(120)
  /** Optional white-label hostname (e.g. portal.client.com). Caddy on-demand TLS ask checks this. */
  customDomain       String?            @unique @db.VarChar(253)
  /** Buyer GSTIN captured at billing checkout; copied onto invoices. */
  buyerGstin         String?            @db.VarChar(20)
  /** Place of supply (state name or GST state code) for tax split. */
  placeOfSupply      String?            @db.VarChar(120)

  users               User[]
  socialIntegrations  SocialIntegration[]
  socialCustomers     SocialCustomer[]
  socialClientTemplates SocialClientTemplate[]
  socialPosts         SocialPost[]
  socialRecurrences   SocialRecurrence[]
  socialMedia         SocialMedia[]
  socialTags          SocialTag[]
  socialSignatures    SocialSignature[]
  socialSavedReplies  SocialSavedReply[]
  socialShortLinks    SocialShortLink[]
  socialSets          SocialSet[]
  socialAutoPosts     SocialAutoPost[]
  socialWebhooks      SocialWebhook[]
  socialNotifications SocialNotification[]
  socialPostErrors    SocialPostError[]
  socialBrandKits     SocialBrandKit[]
  socialAiUsages      SocialAiUsage[]
  socialAiThreads     SocialAiThread[]
  socialAiActions     SocialAiAction[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  googleSheetsConnection SocialGoogleSheetsConnection?
  podoCrmWhatsAppSync   SocialPodoCrmWhatsAppSync?
  adAccounts            AdAccount[]
  invitations           Invitation[]
  clientMembers         SocialClientMember[]
  clientApprovers       ClientApprover[]
  apiClients            SocialApiClient[]
  inboxThreads          SocialInboxThread[]
  leads                 SocialLead[]
  clientReports         SocialClientReport[]
  subscription          SocialSubscription?
  billingInvoices       BillingInvoice[]
  whatsappBroadcasts    WhatsAppBroadcast[]
  whatsappConnections   SocialWhatsAppConnection[]
  whatsappAutoReplies   SocialWhatsAppAutoReply[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

// People who can log in. Every user belongs to one organization.
model User {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  email          String    @unique
  passwordHash   String
  role           UserRole  @default(MEMBER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isPlatformAdmin Boolean  @default(false)
  lastLoginAt     DateTime?

  clientMemberships     SocialClientMember[]
  assignedInboxThreads  SocialInboxThread[]
  aiThreads             SocialAiThread[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("users")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           UserRole
  clientAccess   Json
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

model AuditLog {
  id              String   @id @default(uuid())
  organizationId  String?  
  actorUserId     String?
  impersonatorId  String?
  action          String   
  targetType      String?
  targetId        String?
  metadata        Json?
  ip              String?  @db.VarChar(64)
  createdAt       DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/** Public / Meta App Review data-deletion requests (confirmation code + status URL). */
model DataDeletionRequest {
  id               String    @id @default(uuid())
  confirmationCode String    @unique
  /** Meta user id when the request came from the signed_request callback. */
  metaUserId       String?
  email            String?
  workspaceName    String?
  status           String    @default("received") // received | processing | completed
  source           String    @default("meta_callback") // meta_callback | web_form
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  @@index([status, createdAt])
  @@map("data_deletion_requests")
}

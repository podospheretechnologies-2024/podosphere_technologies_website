2:Tab2,{"@context":"https://schema.org","@graph":[{"@type":"SoftwareApplication","name":"Podo Social","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://social.podospheretechnologies.com","offers":{"@type":"AggregateOffer","priceCurrency":"INR","lowPrice":"1499","highPrice":"19999"},"provider":{"@type":"Organization","name":"PodoSphere Technologies Pvt Ltd","url":"https://social.podospheretechnologies.com"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which platforms are supported?","acceptedAnswer":{"@type":"Answer","text":"Facebook, Instagram, Threads, LinkedIn, YouTube, Pinterest, Google Business Profile and WhatsApp — 8 surfaces in one workspace."}},{"@type":"Question","name":"Does anything go live without my approval?","acceptedAnswer":{"@type":"Answer","text":"No. Posts, replies and ad change suggestions sit in an approval queue until you approve or edit them."}},{"@type":"Question","name":"Can my clients log in?","acceptedAnswer":{"@type":"Answer","text":"Yes. The client portal supports email + password or a magic link. Each client only sees their own channels, ads, leads and reports."}},{"@type":"Question","name":"Is my clients' data separate?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every query is scoped per client and organisation. Team members can be limited to assigned clients."}},{"@type":"Question","name":"Do you support WhatsApp broadcasts? What does it cost?","acceptedAnswer":{"@type":"Answer","text":"Yes — templates, broadcasts with a per-message cost estimate, and keyword auto-replies. Meta template messages are billed separately at Meta’s rate (we show an estimate around ₹0.80/msg in the product)."}},{"@type":"Question","name":"Can I use my own domain and brand?","acceptedAnswer":{"@type":"Answer","text":"Agency plans support white-label portal title, brand colour and a custom domain for the client portal."}},{"@type":"Question","name":"Do you have an API?","acceptedAnswer":{"@type":"Answer","text":"Yes on Agency Pro: posts, analytics, leads and WhatsApp send under /api/v1 with per-key permissions and IP allowlists."}},{"@type":"Question","name":"Which AI do you use?","acceptedAnswer":{"@type":"Answer","text":"Claude by Anthropic powers captions, triage, lead scores and report narratives. Usage is tracked per client."}},{"@type":"Question","name":"Do you give GST invoices?","acceptedAnswer":{"@type":"Answer","text":"Yes. Razorpay checkout in INR with GST invoices (CGST/SGST or IGST split) for Indian agencies."}},{"@type":"Question","name":"How do I get support?","acceptedAnswer":{"@type":"Answer","text":"WhatsApp (+91 91191 05802) or support@podospheretechnologies.com. Monday to Saturday, 10 am to 7 pm IST."}}]}]}14:X
